{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cyber Runner",
  "version": "0.1.0",
  "identifier": "dev.haoqing.cyber-runner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "cargo build --release -p cyber-runner-helper && npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cyber Runner",
        "width": 980,
        "height": 580,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../target/release/cyber-runner-helper": "cyber-runner-helper"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Cyber Runner — cross-platform iOS location simulator.",
    "longDescription": "Cyber Runner is a cross-platform desktop console for fake-running iOS devices via pymobiledevice3. Plug a route in, press start, let the city think you're moving."
  }
}
